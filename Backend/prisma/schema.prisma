// =====================
// PRISMA CONFIG
// =====================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================
// ENUMS
// =====================

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

// =====================
// USER (base entity)
// Fields: user_id, name, email, password, role
// =====================

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(STUDENT)

  // IS A relations
  student    Student?
  instructor Instructor?
  admin      Admin?
}

// =====================
// STUDENT (IS A User)
// Fields: student_id, user_id, major, year
// =====================

model Student {
  id     Int    @id @default(autoincrement())
  major  String?
  year   Int?

  // IS A User
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  enrollments Enrollment[]
}

// =====================
// INSTRUCTOR (IS A User)
// Fields: instructor_id, user_id, department
// =====================

model Instructor {
  id         Int     @id @default(autoincrement())
  department String?

  // IS A User
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  courses Course[]
}

// =====================
// ADMIN (IS A User)
// Fields: admin_id, user_id
// =====================

model Admin {
  id Int @id @default(autoincrement())

  // IS A User
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================
// COURSE
// Fields: course_id, title, description, capacity, instructor_id
// =====================

model Course {
  id           Int     @id @default(autoincrement())
  title        String
  description  String?
  capacity     Int

  // Taught by one Instructor
  instructorId Int
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  // Relations
  enrollments Enrollment[]
  materials   Material[]
  schedules   Schedule[]
}

// =====================
// ENROLLMENT (ENROLS relationship)
// Fields: enrollment_id, student_id, course_id, enrollment_date, status
// =====================

model Enrollment {
  id             Int              @id @default(autoincrement())
  enrollmentDate DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)

  // Student enrolls in Course
  studentId Int
  courseId  Int

  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId]) // prevent duplicate enrollment
}

// =====================
// MATERIAL (CONTAINS relationship)
// Fields: material_id, course_id, title, file_path
// =====================

model Material {
  id       Int    @id @default(autoincrement())
  title    String
  filePath String?

  // Belongs to one Course
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// =====================
// SCHEDULE (HAS A relationship — Course has a Schedule)
// Fields: schedule_id, course_id, day, start_time, end_time, room
// =====================

model Schedule {
  id        Int    @id @default(autoincrement())
  day       String // e.g. "Monday", "Tuesday"
  startTime String // e.g. "10:00"
  endTime   String // e.g. "11:30"
  room      String?

  // Belongs to one Course
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}
