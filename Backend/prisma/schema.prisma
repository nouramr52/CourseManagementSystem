// =====================
// DATASOURCE & GENERATOR
// =====================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================
// ENUMS
// =====================

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

// =====================
// USER
// role field tells us if this user is a STUDENT, INSTRUCTOR, or ADMIN
// no separate tables needed
// =====================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?                   // nullable for Google sign-in users
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  // A user with role INSTRUCTOR can own many courses
  coursesCreated Course[]     @relation("InstructorCourses")

  // A user with role STUDENT can have many enrollments
  enrollments    Enrollment[]

  // Materials uploaded by this user (instructor)
  uploadedMaterials Material[] @relation("UploadedMaterials")
}

// =====================
// COURSE
// =====================

model Course {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  capacity     Int      @default(30)
  dept         String?  // e.g. "Computer Science"
  icon         String?  // emoji icon e.g. "🗄️"
  createdAt    DateTime @default(now())

  // The instructor who owns this course (must be a User with role INSTRUCTOR)
  instructorId Int
  instructor   User @relation("InstructorCourses", fields: [instructorId], references: [id])

  enrollments Enrollment[]
  materials   Material[]
  schedules   Schedule[]
}

// =====================
// ENROLLMENT  (Student enrolls in Course)
// =====================

model Enrollment {
  id             Int              @id @default(autoincrement())
  enrollmentDate DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)

  // The student (User with role STUDENT) who enrolled
  studentId Int
  courseId  Int

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])   // one enrollment per student per course
}

// =====================
// MATERIAL  (Course contains materials)
// =====================

model Material {
  id          Int      @id @default(autoincrement())
  title       String
  type        String   // PDF | PPT | DOC | ZIP | LINK
  url         String   // public URL (Supabase) or link URL
  storagePath String?  // Supabase storage path (null for LINK type)
  filePath    String?  // legacy — kept for backwards compat
  createdAt   DateTime @default(now())

  courseId     Int
  course       Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  uploadedById Int
  uploadedBy   User   @relation("UploadedMaterials", fields: [uploadedById], references: [id])
}

// =====================
// SCHEDULE  (Course has schedule slots)
// =====================

model Schedule {
  id        Int     @id @default(autoincrement())
  day       String  // e.g. "Monday"
  startTime String  // e.g. "10:00"
  endTime   String  // e.g. "11:30"
  room      String?

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}
