// =====================
// DATASOURCE & GENERATOR
// =====================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// =====================
// ENUMS
// =====================

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

// =====================
// USER (base entity)
// Fields: user_id, name, email, password, role
// =====================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  // Relations
  coursesCreated    Course[]     @relation("InstructorCourses")
  enrollments       Enrollment[]
  submissions       Submission[]
  uploadedMaterials Material[]   @relation("UploadedMaterials")
}

// =====================
// COURSE
// Fields: course_id, title, description, capacity, instructor_id
// =====================

model Course {
  id           Int     @id @default(autoincrement())
  title        String
  description  String?
  capacity     Int

  // Taught by one Instructor
  instructorId Int
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  // Relations
  enrollments Enrollment[]
  assignments Assignment[]
  materials   Material[]
}

// =====================
// ENROLLMENT (ENROLS relationship)
// Fields: enrollment_id, student_id, course_id, enrollment_date, status
// =====================

model Enrollment {
  id             Int              @id @default(autoincrement())
  enrollmentDate DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)

  // Student enrolls in Course
  studentId Int
  courseId  Int

  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId]) // prevent duplicate enrollment
}

// =====================
// MATERIAL (CONTAINS relationship)
// Fields: material_id, course_id, title, file_path
// =====================

model Material {
  id       Int    @id @default(autoincrement())
  title    String
  filePath String?

  // Belongs to one Course
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// =====================
// SCHEDULE (HAS A relationship — Course has a Schedule)
// Fields: schedule_id, course_id, day, start_time, end_time, room
// =====================

model Schedule {
  id        Int    @id @default(autoincrement())
  day       String // e.g. "Monday", "Tuesday"
  startTime String // e.g. "10:00"
  endTime   String // e.g. "11:30"
  room      String?

  // Relations
  assignmentId Int
  studentId    Int

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId]) // one submission per student per assignment
}

// =====================
// MATERIAL
// =====================

enum MaterialType {
  PDF
  PPT
  DOC
  ZIP
  LINK
}

model Material {
  id           Int          @id @default(autoincrement())
  title        String
  type         MaterialType
  url          String       // Supabase Storage public URL (for files) or external link (for LINK type)
  storagePath  String?      // Supabase Storage path, only set for uploaded files (not LINK type)
  courseId     Int
  uploadedById Int
  createdAt    DateTime     @default(now())

  // Relations
  course      Course @relation(fields: [courseId], references: [id])
  uploadedBy  User   @relation("UploadedMaterials", fields: [uploadedById], references: [id])
}
