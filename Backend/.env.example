# Database Configuration
DATABASE_URL="your-database-url-here"
DIRECT_URL="your-direct-database-url-here"

# JWT Secret
JWT_SECRET="your-jwt-secret-here"

# Server Port
PORT=5000

# Supabase Configuration
VITE_SUPABASE_URL="your-supabase-url"
VITE_SUPABASE_SERVICE_ROLE_KEY="your-supabase-key"
VITE_SUPABASE_BUCKET="bucket"

# Email Configuration (OPTIONAL)
# Leave these empty to use Ethereal test emails (recommended for development)
# The system will automatically generate test emails and show preview URLs in console
# 
# For production, use a real email service:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-team-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM="Course Management System <your-team-email@gmail.com>"
